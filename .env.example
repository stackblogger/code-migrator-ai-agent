# Copy to .env and fill values. Never commit .env.
# LLM is used from milestone M5 onwards. M1 does not call any LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_MODEL_CHEAP=gpt-5.6-luna
OPENAI_MODEL_STRONG=gpt-6-astra

# Folder with your own repos, mounted read-only at /repos/workspace in docker compose.
REPOS_DIR=./workspace
